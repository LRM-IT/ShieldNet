FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/shieldnet/backend
WORKDIR /opt/shieldnet/backend
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY plugins /opt/shieldnet/plugins
RUN mkdir -p /opt/shieldnet/plugin-runtime /var/lib/shieldnet/templates /var/lib/shieldnet/media-assets
