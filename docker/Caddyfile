:80 {
    encode zstd gzip
    handle /api/* {
        reverse_proxy backend:8000 {
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }
    @publicDocs path /docs /docs/
    handle @publicDocs {
        root * /srv
        rewrite * /index.html
        file_server
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
