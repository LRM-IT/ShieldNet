{
  "id": "voting",
  "name": "ShieldNet Voting",
  "version": "2.1.0",
  "description": "Multilingual Discord polls with manual and AI-assisted translations.",
  "author": "LRM-IT",
  "min_core_version": "5.1.0",
  "components": {
    "backend": true,
    "frontend": true,
    "bot": true
  },
