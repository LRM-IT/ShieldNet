  "dependencies": {},
  "ui": {"navigation": {"label": "Translator Groups", "icon": "🌐", "route": "plugins/translator-groups"}},
  "entrypoints": {
    "backend": "runtime:TranslatorGroupsPlugin",
    "frontend": "admin-frontend/src/app/pages/plugin-translator-groups.component.ts",
    "bot": "bot/bot/plugin_translator_groups.py"
  },
  "entrypoint": "runtime.py"
}
