{
  "id": "translator_groups",
  "name": "Translator Groups",
  "version": "1.0.1",
  "description": "Translate messages between language channels in a group through the server AI Center.",
  "author": "LRM-IT",
  "min_core_version": "5.1.0",
  "components": {"backend": true, "frontend": true, "bot": true},
  "capabilities": ["discord.read.guild", "discord.send.message", "discord.manage.webhooks", "ai.chat"],
