{
  "id": "verification_level1",
  "name": "Verification",
  "version": "2.0.0",
  "description": "Multi-level verification with forms, AI profile-image checks and configurable role assignment.",
  "author": "LRM-IT",
  "min_core_version": "5.1.0",
  "components": {
    "backend": true,
    "frontend": true,
    "bot": true
  },
  "capabilities": [
    "discord.read.guild",
    "discord.read.members",
    "discord.send.message",
    "discord.manage.roles",
    "events.publish"
  ],
  "permissions": [
    "manage_nicknames",
    "manage_roles",
    "send_messages",
    "manage_messages",
    "use_application_commands"
  ],
  "dependencies": {},
  "ui": {
    "navigation": {
      "label": "Verification",
      "icon": "✅",
      "route": "plugins/verification-level1"
    }
  },
  "entrypoints": {
    "backend": "runtime:VerificationLevel1Plugin",
    "frontend": "admin-frontend/src/app/pages/plugin-verification-level1.component.ts",
    "bot": "bot/bot/plugin_verification_level1.py"
  },
  "entrypoint": "runtime.py"
}
