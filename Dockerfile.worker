FROM python:3.12-slim
ARG COMPONENT
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN if [ "$COMPONENT" = "bot" ]; then apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core && rm -rf /var/lib/apt/lists/*; fi
WORKDIR /opt/shieldnet
COPY ${COMPONENT}/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY ${COMPONENT} /opt/shieldnet/${COMPONENT}
