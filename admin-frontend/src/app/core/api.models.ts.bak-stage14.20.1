export interface TokenPair {
  access_token: string;
  refresh_token: string;
  token_type: string;
  expires_in: number;
}

export interface UserProfile {
  id: string;
  email: string;
  login: string;
  display_name: string | null;
  avatar_url: string | null;
  discord_user_id: string | null;
